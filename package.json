{
  "name": "player.vm.console.ui",
  "version": "3.0.5",
  "license": "MIT",
  "config": {
    "openapiArgs": "--additional-properties ngVersion=21 --additional-properties modelPropertyNaming=original --type-mappings=DateTime=string",
    "deleteGeneratedCommand": "rimraf src/app/generated/vm-api/"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --configuration coverage",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "swagger:gen": "curl --insecure http://localhost:4302/swagger/v1/swagger.json --output swagger.json && node_modules/@openapitools/openapi-generator-cli/bin/openapi-generator generate -i ./swagger.json -g typescript-angular -o src/app/generated/vm-api --additional-properties ngVersion=9.1 --additional-properties useRxJS6=true --additional-properties modelPropertyNaming=original",
    "swagger:gen-docker": "cross-var $npm_package_config_deleteGeneratedCommand && cross-env-shell docker run --rm -v $INIT_CWD:/local openapitools/openapi-generator-cli:v7.2.0 generate -i http://host.docker.internal:4302/swagger/v1/swagger.json?format=openapi -g typescript-angular -o /local/src/app/generated/vm-api $npm_package_config_openapiArgs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/localize": "^21.2.12",
    "@angular/material": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@cmusei/crucible-common": "0.7.3",
    "@datorama/akita": "^8.0.1",
    "@datorama/akita-ng-router-store": "^8.0.0",
    "@material/material-color-utilities": "^0.4.0",
    "@microsoft/signalr": "^10.0.0",
    "@novnc/novnc": "1.5.0",
    "babel-polyfill": "^6.26.0",
    "bootstrap": "^5.3.8",
    "jquery": "^3.7.1",
    "jquery-ui-dist": "^1.13.3",
    "oidc-client-ts": "^3.4.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tslint-config-prettier": "^1.18.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.12",
    "@angular/language-service": "^21.2.12",
    "@datorama/akita-ngdevtools": "^7.0.0",
    "@testing-library/angular": "^19.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jasminewd2": "^2.0.13",
    "@types/jquery": "^3.5.33",
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^4.1.5",
    "codelyzer": "^6.0.2",
    "cross-env": "^10.1.0",
    "cross-var": "^1.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "jsdom": "^28.1.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "tslib": "^2.8.1"
  }
}
